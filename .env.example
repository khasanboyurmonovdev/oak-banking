# Copy to .env.local (dev). In production these live in /etc/oak-banking.env (see README). All values are optional in dev.

# SQLite file path. Its directory is created on first use.
DATABASE_PATH=./data/oak.db

# HMAC key for the session cookie. Required in production, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Sliding session lifetime in hours; idle sandboxes are purged after this.
SESSION_TTL_HOURS=72

# Most demo sandboxes kept at once; the least recently seen are evicted beyond this.
MAX_SESSIONS=500
